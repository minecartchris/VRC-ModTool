# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- Secrets / credentials (NEVER commit) ----
vrc_cookies.txt

# ---- Local user config (copy the .example files and edit) ----
config.json
triggers.txt
web_config.json
.claude/settings.local.json

# ---- Private runtime data (other people's info — keep local) ----
# SQLite store (incidents + screening cache) and its WAL side-files
*.db
*.db-wal
*.db-shm
# Database backups. Named separately because "modtool.db.bak-preweb" does not
# match *.db, and these hold the same private notes the live store does.
*.bak
*.bak-*
*.db.*
incidents.jsonl
incidents.tmp
incident_shots/
screening_db.json

# ---- Logs ----
*.log

# ---- Offline speech models (large; download separately) ----
vosk-model-*/

# ---- OS cruft ----
Thumbs.db
.DS_Store

# ---- Roster agent settings (generated on first run) ----
agent_config.json
