# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- Secrets / credentials (NEVER commit) ----
vrc_cookies.txt

# ---- Local user config (copy the .example files and edit) ----
config.json
triggers.txt
web_config.json
.claude/settings.local.json

# ---- Private runtime data (other people's info — keep local) ----
# SQLite store (incidents + screening cache) and its WAL side-files
*.db
*.db-wal
*.db-shm
# Database backups. Named separately because "modtool.db.bak-preweb" does not
# match *.db, and these hold the same private notes the live store does.
*.bak
*.bak-*
*.db.*
incidents.jsonl
incidents.tmp
incident_shots/
screening_db.json

# ---- Logs ----
*.log

# ---- Offline speech models (large; download separately) ----
vosk-model-*/

# ---- OS cruft ----
Thumbs.db
.DS_Store

# ---- Roster agent settings (generated on first run) ----
agent_config.json

# ---- Agent build artifacts ----
dist/
build/
*.spec
agent_baked.py

# ---- Misc ----
*.zip
test.py
NEXT-UPDATE.md
# Quest agent (Android). Build output, the machine's SDK path, and the
# upload key — losing that key means never updating the store listing, and
# committing it means anybody can publish as us.
quest-agent/build/
quest-agent/app/build/
quest-agent/.gradle/
quest-agent/local.properties
quest-agent/keystore.properties
*.jks
*.keystore
quest-agent/release.local.json
quest-agent/upload.jks
quest-agent/ovr-platform-util.exe

# Docker bind mounts: the live database and the config with its secrets.
# Compose creates these in the repo root, so they must never be committable.
/data/
/config/
